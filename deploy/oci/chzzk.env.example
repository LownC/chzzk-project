# ⑥ OCI VM 환경 파일 예시. VM에서 /etc/chzzk/chzzk.env 로 복사하고 값을 바꾼다(sudo chmod 600, 소유자 root).
# 실제 값은 Git·README에 넣지 않는다.

# 데이터 볼륨(/data/chzzk)의 H2 파일 DB 폴더와 업로드 영상 폴더
APP_DATA_DIR=/data/chzzk/db
APP_UPLOAD_DIR=/data/chzzk/uploads

# 새 H2 DB(sa 계정) 비밀번호. 처음 시작할 때의 값으로 DB가 만들어지므로 이후에도 같은 값을 쓴다.
CHZZK_DB_PASSWORD=change-me

# (선택) 라이브 STUN/TURN 주소(쉼표 구분). 비워 두면 같은 네트워크 안에서만 연결을 기대할 수 있다.
APP_LIVE_ICE_SERVERS=

# (선택) 다운로드 페이지의 패키지 주소. 패키지를 실제로 게시한 뒤에만 넣는다.
APP_DOWNLOAD_WINDOWS_X64_URL=
APP_DOWNLOAD_MACOS_ARM64_URL=
