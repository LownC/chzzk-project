# ⑤ deploy/compose.yaml 환경변수 예시. 이 파일을 deploy/.env로 복사하고 값을 바꿔 쓴다(.env는 Git에 올라가지 않음).
# 공용 H2 DB(sa 계정) 비밀번호. 처음 띄울 때의 값으로 DB가 만들어지므로 이후에도 같은 값을 쓴다.
CHZZK_DB_PASSWORD=change-me-local-only
# 부하 분산기(nginx)를 열 로컬 포트(127.0.0.1에만 열림)
CHZZK_HTTP_PORT=18090
# 라이브 WebRTC STUN/TURN 주소(쉼표 구분). 같은 PC·같은 Wi-Fi에서는 비워 둔다.
APP_LIVE_ICE_SERVERS=
